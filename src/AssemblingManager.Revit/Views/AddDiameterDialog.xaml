<Window x:Class="AssemblingManager.Revit.Views.AddDiameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить размер"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Width="320">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SecondaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#FFF0F0F0" />
                <Setter Property="Foreground" Value="#FF202020" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FFC8C8C8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Введите номинальный диаметр:"
                   Margin="0,0,0,8" />
        <TextBox x:Name="DiameterTextBox"
                 Grid.Row="1"
                 Height="28"
                 Padding="4,2"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="UnitTextBlock"
                   Grid.Row="2"
                   Foreground="Gray"
                   Margin="0,6,0,14" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    Click="ButtonCancel_Click" />
            <Button Content="Добавить"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="ButtonAdd_Click" />
        </StackPanel>
    </Grid>
</Window>
