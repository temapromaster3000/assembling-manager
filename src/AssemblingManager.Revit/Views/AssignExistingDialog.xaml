<Window x:Class="AssemblingManager.Revit.Views.AssignExistingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить существующее"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="640"
        Width="560">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Выбранным элементам (и их вложенным семействам) будет записано имя выбранной сборки. Выберите сборку:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,10">
            <RadioButton x:Name="RadioButtonCreateNew"
                         GroupName="ParameterMode"
                         Content="Параметр плагина (AssemblyParameter)"
                         IsChecked="True"
                         Margin="0,0,0,4" />
            <TextBlock x:Name="TextBlockPluginParameterStatus"
                       Margin="20,0,0,8"
                       FontSize="11"
                       Foreground="Gray" />
            <RadioButton x:Name="RadioButtonUseGrouping"
                         GroupName="ParameterMode"
                         Content="Существующий параметр (ADSK_Группирование)" />
            <TextBlock x:Name="TextBlockGroupingParameterStatus"
                       Margin="20,0,0,0"
                       FontSize="11"
                       Foreground="Gray" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="TextBlockElementCount"
                   Text="Выбрано элементов: 0 (в т.ч. вложенных: 0)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="3"
              Margin="0,0,0,10">
            <TextBox x:Name="SearchTextBox"
                     Height="26"
                     Padding="4,3,24,3"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     KeyDown="SearchTextBox_KeyDown" />
            <TextBlock Text="Поиск по сборке…"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="✕"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="Gray"
                    Cursor="Hand"
                    Click="ButtonClearSearch_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ListView Grid.Row="4"
                  x:Name="AssembliesListView"
                  AlternationCount="2"
                  SelectionMode="Single"
                  SelectionChanged="AssembliesListView_SelectionChanged"
                  MouseDoubleClick="AssembliesListView_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F5F7F8" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="№"
                                    DisplayMemberBinding="{Binding Num}"
                                    Width="45" />
                    <GridViewColumn Header="Сборка"
                                    Width="415">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="5"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TextBlockAssemblyCount"
                       VerticalAlignment="Center"
                       Text="Сборок: 0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="80"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />

                <Button x:Name="ButtonOK"
                        Content="OK"
                        Width="80"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ButtonOK_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
