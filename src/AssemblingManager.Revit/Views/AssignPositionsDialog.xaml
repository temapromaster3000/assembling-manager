<Window x:Class="AssemblingManager.Revit.Views.AssignPositionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проставить позиции"
        Width="760"
        Height="600"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Ключевые слова (пропуск строк)">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="KeywordsPanel" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button x:Name="ButtonAddKeyword"
                                Content="+ Добавить"
                                Width="90"
                                Height="26"
                                Margin="0,0,8,0"
                                Click="ButtonAddKeyword_Click" />
                        <Button x:Name="ButtonRemoveKeyword"
                                Content="− Удалить"
                                Width="90"
                                Height="26"
                                Click="ButtonRemoveKeyword_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Спецификации (как в диспетчере)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,8">
                        <TextBox x:Name="SearchTextBox"
                                 Height="26"
                                 Padding="4,3,24,3"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <TextBlock Text="Поиск по имени спецификации…"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="Gray"
                                Cursor="Hand"
                                Click="ButtonClearSearch_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TreeView x:Name="SchedulesTreeView"
                              Grid.Row="1"
                              ItemsSource="{Binding}"
                              Margin="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                             Handler="TreeViewItem_PreviewMouseLeftButtonDown" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding VisibleChildren}">
                                <Border Padding="3,2"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FFC9E1FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">
                <CheckBox x:Name="MergeSchedulesCheckBox"
                          Content="Объединить спецификации"
                          IsEnabled="False"
                          Margin="0,0,0,6"
                          ToolTip="Сквозная нумерация по нескольким спецификациям: идентичные элементы (по ADSK_Наименование) получают одну и ту же позицию. Активна при выборе более одной спецификации. Настройка не сохраняется между запусками." />

                <TextBlock x:Name="SummaryTextBlock"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontWeight="Bold" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="80"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />

                <Button x:Name="ButtonOK"
                        Content="Выполнить"
                        Width="120"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ButtonOK_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
