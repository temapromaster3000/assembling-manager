<Window x:Class="AssemblingManager.Revit.Views.ElevationCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка отметок"
        Width="780"
        Height="640"
        MinWidth="620"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TreeViewItem">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FFC9E1FF" />
                        <Setter Property="Foreground" Value="#FF0B4FA8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ElevationSecondaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#FFF0F0F0" />
                <Setter Property="Foreground" Value="#FF202020" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FFC8C8C8" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FFE5E5E5" />
                        <Setter Property="Foreground" Value="#FF888888" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ContextMenu x:Key="ResultsRowContextMenu" x:Shared="False">
                <MenuItem Header="Перейти к листу"
                          Click="MenuItemGoToSheet_Click" />
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="Комплект листов (как в диспетчере листов)">
            <TreeView x:Name="GroupTreeView"
                      Margin="4"
                      SelectedItemChanged="GroupTreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </GroupBox>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectionTextBlock"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#FF5A6B7B"
                       Text="Выберите комплект листов." />

            <Button x:Name="ButtonCheck"
                    Grid.Column="1"
                    Content="Проверить"
                    Width="120"
                    Height="30"
                    Margin="12,0,0,0"
                    IsEnabled="False"
                    Click="ButtonCheck_Click"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

        <TextBlock x:Name="SummaryTextBlock"
                   Grid.Row="2"
                   Margin="0,10,0,10"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <GroupBox Grid.Row="3"
                  Header="Листы без высотных отметок">
            <Grid>
                <DataGrid x:Name="ResultsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#FFE3E8EE"
                          AlternatingRowBackground="#FFF7FAFD"
                          Background="White"
                          BorderBrush="#FFD0D7DE"
                          BorderThickness="1"
                          RowHeight="28"
                          ColumnHeaderHeight="30"
                          PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown"
                          MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ листа"
                                            Binding="{Binding SheetNumber}"
                                            Width="90" />
                        <DataGridTextColumn Header="Имя листа"
                                            Binding="{Binding SheetName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Видов на листе"
                                            Binding="{Binding PlacedViewCount}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu" Value="{StaticResource ResultsRowContextMenu}" />
                            <Setter Property="ToolTip" Value="{Binding ViewsText}" />
                            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="Выберите комплект и нажмите «Проверить»."
                           Foreground="#FF8A96A0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           IsHitTestVisible="False"
                           Panel.ZIndex="1" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#FF5A6B7B" />

            <Button Grid.Column="1"
                    Content="Закрыть"
                    Width="90"
                    Height="30"
                    Margin="12,0,0,0"
                    Click="ButtonClose_Click"
                    Style="{StaticResource ElevationSecondaryButton}" />
        </Grid>
    </Grid>
</Window>
