<Window x:Class="AssemblingManager.Revit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AssemblingManager.Revit.Views"
        Title="Assembling Manager"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:NullableBooleanToBooleanConverter x:Key="NullableBoolConverter" />
        <Style x:Key="DisabledGrayTextBlock" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DisabledGrayComboBox" TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SplitViewsGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#FFD5DFE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1"
                                    Grid.RowSpan="2"
                                    CornerRadius="4"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />

                            <ContentPresenter Grid.Row="0"
                                              Grid.RowSpan="2"
                                              ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="12,0,6,0"
                                              RecognizesAccessKey="True" />

                            <ContentPresenter Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupBoxHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0063B1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF004E8C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFD0D7DE" />
                    <Setter Property="Foreground" Value="#FF9AA4AF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Height="135"
                      Padding="10">
                <GroupBox.Header>
                    <TextBlock Text="Параметр для фильтра"
                               Style="{StaticResource GroupBoxHeader}" />
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="RadioButtonCreateNew"
                                     Content="Создать новый общий параметр"
                                     GroupName="ParameterMode"
                                     HorizontalAlignment="Left"
                                     Checked="ParameterMode_Checked"
                                     Unchecked="ParameterMode_Unchecked" />

                        <RadioButton x:Name="RadioButtonUseGrouping"
                                     Content="Использовать &quot;ADSK__Группирование&quot;"
                                     GroupName="ParameterMode"
                                     HorizontalAlignment="Left"
                                     Margin="0,5,0,0"
                                     Checked="ParameterMode_Checked"
                                     Unchecked="ParameterMode_Unchecked" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TextBlockLine1"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="TextBlockLine2"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Style="{StaticResource SplitViewsGroupBox}"
                      Height="135"
                      Padding="0">
                <GroupBox.Header>
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="93" />
                            <ColumnDefinition Width="21" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Виды"
                                   Style="{StaticResource GroupBoxHeader}"
                                   Background="{x:Static SystemColors.WindowBrush}"
                                   HorizontalAlignment="Left" />

                        <TextBlock Grid.Column="2"
                                   Text="Типы видов"
                                   Style="{StaticResource GroupBoxHeader}"
                                   Background="{x:Static SystemColors.WindowBrush}"
                                   Margin="1.5,0,0,0" />
                    </Grid>
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="1"
                            Grid.RowSpan="4"
                            Width="1"
                            Margin="10,0"
                            Background="Gray"
                            BorderThickness="0" />

                    <CheckBox x:Name="CheckBoxPlan"
                              Grid.Row="0"
                              Content="План"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="10,10,0,2"
                              IsChecked="False"
                              Checked="IndividualCheckBox_CheckedChanged"
                              Unchecked="IndividualCheckBox_CheckedChanged" />

                    <ComboBox Grid.Row="0"
                              Grid.Column="2"
                              x:Name="ComboBoxPlanType"
                              VerticalAlignment="Center"
                              Margin="0,10,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,2,0,2">
                        <CheckBox x:Name="CheckBoxSections"
                                  Content="Разрезы"
                                  HorizontalAlignment="Left"
                                  IsThreeState="True"
                                  IsChecked="False"
                                  Click="CheckBoxSections_Click"
                                  VerticalAlignment="Center" />

                        <Button x:Name="ButtonSectionOptions"
                                Width="18"
                                Height="16"
                                Margin="5,0,0,0"
                                BorderThickness="0"
                                Background="Transparent"
                                ToolTip="Направления разрезов"
                                Click="ButtonSectionOptions_Click"
                                PreviewMouseDown="ButtonSectionOptions_PreviewMouseDown"
                                VerticalAlignment="Center"
                                Padding="0">
                            <Path Data="M 0,0 L 4,3.5 L 8,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="#FF444444" />
                                        <Setter Property="StrokeThickness" Value="1.6" />
                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                        <Setter Property="StrokeLineJoin" Value="Round" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen, ElementName=PopupSectionOptions}"
                                                         Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ButtonSectionOptions}"
                                                         Value="True">
                                                <Setter Property="Stroke" Value="#FF111111" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Popup x:Name="PopupSectionOptions"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-4" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=PopupSectionOptions}"
                                                     Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         To="0"
                                                                         Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                    <CheckBox x:Name="CheckBoxFrontView"
                                              Content="Вид спереди"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxBackView"
                                              Content="Вид сзади"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxRightView"
                                              Content="Вид справа"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxLeftView"
                                              Content="Вид слева"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <ComboBox Grid.Row="1"
                              Grid.Column="2"
                              x:Name="ComboBoxSectionType"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}" />

                    <CheckBox x:Name="CheckBox3D"
                              Grid.Row="2"
                              Content="3D вид"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="10,2,0,2"
                              IsChecked="False"
                              Checked="IndividualCheckBox_CheckedChanged"
                              Unchecked="IndividualCheckBox_CheckedChanged" />

                    <ComboBox Grid.Row="2"
                              Grid.Column="2"
                              x:Name="ComboBoxView3DType"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Height="170"
                      Padding="10"
                      VerticalAlignment="Top">
                <GroupBox.Header>
                    <TextBlock Text="Шаблоны видов"
                               Style="{StaticResource GroupBoxHeader}" />
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="План:"
                               ToolTip="Включите вид &quot;План&quot;, чтобы выбрать шаблон"
                               IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="1"
                              x:Name="ComboBoxPlanTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}" />

                    <TextBlock Grid.Row="2"
                               Text="Разрезы:"
                               ToolTip="Включите разрезы, чтобы выбрать шаблон"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="3"
                              x:Name="ComboBoxSectionTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}" />

                    <TextBlock Grid.Row="4"
                               Text="3D вид:"
                               ToolTip="Включите 3D вид, чтобы выбрать шаблон"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="5"
                              x:Name="ComboBoxView3DTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Height="170"
                      Padding="10"
                      VerticalAlignment="Top">
                <GroupBox.Header>
                    <Border Background="{x:Static SystemColors.WindowBrush}"
                            Padding="3,0">
                        <CheckBox x:Name="CheckBoxSchedule"
                                  Content="Спецификация"
                                  FontWeight="Bold"
                                  ToolTip="Создавать спецификацию для каждой сборки"
                                  IsChecked="False"
                                  Checked="IndividualCheckBox_CheckedChanged"
                                  Unchecked="IndividualCheckBox_CheckedChanged" />
                    </Border>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Мастер-спецификация:"
                               ToolTip="Включите спецификацию, чтобы выбрать мастер-спецификацию"
                               IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="1"
                              x:Name="ComboBoxMasterSchedule"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                              SelectionChanged="ComboBoxMasterSchedule_SelectionChanged" />

                    <TextBlock Grid.Row="2"
                               Text="Шаблон вида:"
                               ToolTip="Включите спецификацию, чтобы выбрать шаблон вида"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="3"
                              x:Name="ComboBoxScheduleTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}" />
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">
            <Grid HorizontalAlignment="Right" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Сборок в проекте:"
                           TextAlignment="Right" />

                <TextBlock x:Name="TextBlockAssemblyCount"
                           Grid.Row="0" Grid.Column="2"
                           Text="0" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Будет создано видов:"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           Margin="0,5,0,0" />

                <TextBlock x:Name="TextBlockViewCount"
                           Grid.Row="1" Grid.Column="2"
                           Text="0"
                           FontWeight="Bold"
                           Margin="0,5,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="ButtonCancel"
                         Content="Отмена"
                         Width="80"
                         Margin="0,0,10,0"
                         IsCancel="True"
                         Click="ButtonCancel_Click" />

                <Button x:Name="ButtonCreate"
                         Content="Сформировать"
                         Width="120"
                         IsDefault="True"
                         Click="ButtonCreate_Click"
                         Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
