<Window x:Class="AssemblingManager.Revit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AssemblingManager.Revit.Views"
        Title="Assembling Manager"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:NullableBooleanToBooleanConverter x:Key="NullableBoolConverter" />
        <Style x:Key="DisabledGrayTextBlock" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="Gray" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DisabledGrayComboBox" TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SplitViewsGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#FFD5DFE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1"
                                    Grid.RowSpan="2"
                                    CornerRadius="4"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />

                            <ContentPresenter Grid.Row="0"
                                              Grid.RowSpan="2"
                                              ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="12,0,6,0"
                                              RecognizesAccessKey="True" />

                            <ContentPresenter Grid.Row="1"
                                              Grid.RowSpan="2"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Параметр для фильтра"
                      Height="150"
                      Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="RadioButtonCreateNew"
                                     Content="Создать новый общий параметр"
                                     GroupName="ParameterMode"
                                     HorizontalAlignment="Left"
                                     Checked="ParameterMode_Checked"
                                     Unchecked="ParameterMode_Unchecked" />

                        <RadioButton x:Name="RadioButtonUseGrouping"
                                     Content="Использовать &quot;ADSK__Группирование&quot;"
                                     GroupName="ParameterMode"
                                     HorizontalAlignment="Left"
                                     Margin="0,5,0,0"
                                     Checked="ParameterMode_Checked"
                                     Unchecked="ParameterMode_Unchecked" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TextBlockLine1"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="TextBlockLine2"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Style="{StaticResource SplitViewsGroupBox}"
                      Padding="0">
                <GroupBox.Header>
                    <Grid Background="{x:Static SystemColors.WindowBrush}"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="93" />
                            <ColumnDefinition Width="21" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Виды"
                                   HorizontalAlignment="Left" />

                        <TextBlock Grid.Column="2"
                                   Text="Типы видов"
                                   Margin="1.5,0,0,0" />
                    </Grid>
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="1"
                            Grid.RowSpan="4"
                            Width="1"
                            Margin="10,0"
                            Background="Gray"
                            BorderThickness="0" />

                    <CheckBox x:Name="CheckBoxPlan"
                              Grid.Row="0"
                              Content="План"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="10,10,0,2"
                              IsChecked="False"
                              Checked="IndividualCheckBox_CheckedChanged"
                              Unchecked="IndividualCheckBox_CheckedChanged" />

                    <ComboBox Grid.Row="0"
                              Grid.Column="2"
                              x:Name="ComboBoxPlanType"
                              VerticalAlignment="Center"
                              Margin="0,10,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,2,0,2">
                        <CheckBox x:Name="CheckBoxSections"
                                  Content="Разрезы"
                                  HorizontalAlignment="Left"
                                  IsThreeState="True"
                                  IsChecked="False"
                                  Click="CheckBoxSections_Click"
                                  VerticalAlignment="Center" />

                        <Button x:Name="ButtonSectionOptions"
                                Width="16"
                                Height="16"
                                Margin="5,0,0,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="ButtonSectionOptions_Click"
                                PreviewMouseDown="ButtonSectionOptions_PreviewMouseDown"
                                VerticalAlignment="Center"
                                Padding="0">
                            <TextBlock Text="&#xE011;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Popup x:Name="PopupSectionOptions"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Padding="10">
                                <StackPanel>
                                    <CheckBox x:Name="CheckBoxFrontView"
                                              Content="Вид спереди"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxBackView"
                                              Content="Вид сзади"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxRightView"
                                              Content="Вид справа"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />

                                    <CheckBox x:Name="CheckBoxLeftView"
                                              Content="Вид слева"
                                              IsChecked="False"
                                              Margin="0,3"
                                              Checked="IndividualCheckBox_CheckedChanged"
                                              Unchecked="IndividualCheckBox_CheckedChanged" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <ComboBox Grid.Row="1"
                              Grid.Column="2"
                              x:Name="ComboBoxSectionType"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}" />

                    <CheckBox x:Name="CheckBox3D"
                              Grid.Row="2"
                              Content="3D вид"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Margin="10,2,0,2"
                              IsChecked="False"
                              Checked="IndividualCheckBox_CheckedChanged"
                              Unchecked="IndividualCheckBox_CheckedChanged" />

                    <ComboBox Grid.Row="2"
                              Grid.Column="2"
                              x:Name="ComboBoxView3DType"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Шаблоны видов"
                      Height="170"
                      Padding="10"
                      VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="План:"
                               IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="1"
                              x:Name="ComboBoxPlanTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxPlan, Path=IsChecked}" />

                    <TextBlock Grid.Row="2"
                               Text="Разрезы:"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="3"
                              x:Name="ComboBoxSectionTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSections, Path=IsChecked, Converter={StaticResource NullableBoolConverter}}" />

                    <TextBlock Grid.Row="4"
                               Text="3D вид:"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="5"
                              x:Name="ComboBoxView3DTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBox3D, Path=IsChecked}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Спецификация"
                      Height="170"
                      Padding="10"
                      VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="CheckBoxSchedule"
                              Grid.Row="1"
                              Content="Спецификация для каждой сборки"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsChecked="False"
                              Checked="IndividualCheckBox_CheckedChanged"
                              Unchecked="IndividualCheckBox_CheckedChanged" />

                    <TextBlock Grid.Row="2"
                               Text="Мастер-спецификация:"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="3"
                              x:Name="ComboBoxMasterSchedule"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                              SelectionChanged="ComboBoxMasterSchedule_SelectionChanged" />

                    <TextBlock Grid.Row="4"
                               Text="Шаблон вида:"
                               Margin="0,4,0,0"
                               IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}"
                               Style="{StaticResource DisabledGrayTextBlock}" />
                    <ComboBox Grid.Row="5"
                              x:Name="ComboBoxScheduleTemplate"
                              Style="{StaticResource DisabledGrayComboBox}"
                              IsEnabled="{Binding ElementName=CheckBoxSchedule, Path=IsChecked}" />
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">
            <Grid HorizontalAlignment="Right" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Сборок в проекте:"
                           TextAlignment="Right" />

                <TextBlock x:Name="TextBlockAssemblyCount"
                           Grid.Row="0" Grid.Column="2"
                           Text="0" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Будет создано видов:"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           Margin="0,5,0,0" />

                <TextBlock x:Name="TextBlockViewCount"
                           Grid.Row="1" Grid.Column="2"
                           Text="0"
                           FontWeight="Bold"
                           Margin="0,5,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="ButtonCancel"
                         Content="Отмена"
                         Width="80"
                         Margin="0,0,10,0"
                         IsCancel="True"
                         Click="ButtonCancel_Click" />

                <Button x:Name="ButtonCreate"
                         Content="Сформировать"
                         Width="100"
                         IsDefault="True"
                         Click="ButtonCreate_Click"
                         Background="Blue"
                         Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
