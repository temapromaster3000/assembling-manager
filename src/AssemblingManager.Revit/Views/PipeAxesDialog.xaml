<Window x:Class="AssemblingManager.Revit.Views.PipeAxesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оси трубопроводов"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="710"
        Width="560">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Отметьте сборки, на планах и разрезах которых нужно построить осевые линии трубопроводов:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <TextBox x:Name="SearchTextBox"
                     Height="26"
                     Padding="4,3,24,3"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     KeyDown="SearchTextBox_KeyDown" />
            <TextBlock Text="Поиск по сборке…"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="✕"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="Gray"
                    Cursor="Hand"
                    Click="ButtonClearSearch_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ListView Grid.Row="2"
                  x:Name="AssembliesListView"
                  AlternationCount="2"
                  SelectionMode="Single"
                  PreviewMouseLeftButtonDown="AssembliesListView_PreviewMouseLeftButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F5F7F8" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="№"
                                    DisplayMemberBinding="{Binding Num}"
                                    Width="45" />
                    <GridViewColumn Header="Взять"
                                    Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="50">
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="CheckBox_Click" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сборка"
                                    Width="355">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3"
              Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Стиль линии осей:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      x:Name="StyleComboBox"
                      Height="26"
                      VerticalContentAlignment="Center" />

            <CheckBox Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      x:Name="SkipOccludedCheckBox"
                      Content="Пропускать перекрытые участки осей (рисовать только видимые)"
                      IsChecked="True"
                      Margin="0,10,0,0" />
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TextBlockSelectedCount"
                       VerticalAlignment="Center"
                       Text="Выбрано: 0 из 0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ButtonSelectAll"
                        Content="Выбрать всё"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="ButtonSelectAll_Click" />

                <Button x:Name="ButtonDelete"
                        Content="Удалить оси"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="ButtonDelete_Click" />

                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="80"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />

                <Button x:Name="ButtonApply"
                        Content="Нанести оси"
                        Width="100"
                        IsDefault="True"
                        Click="ButtonApply_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
