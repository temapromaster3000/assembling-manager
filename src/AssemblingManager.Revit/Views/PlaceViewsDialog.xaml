<Window x:Class="AssemblingManager.Revit.Views.PlaceViewsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Разместить виды на листах"
        Width="720"
        Height="540"
        MinWidth="580"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TreeViewItem">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FFC9E1FF" />
                        <Setter Property="Foreground" Value="#FF0B4FA8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Группа видов (как в диспетчере видов)">
                <TreeView x:Name="GroupTreeView"
                          Margin="4"
                          SelectedItemChanged="GroupTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Лист-образец (как в диспетчере листов)">
                <TreeView x:Name="SheetsTreeView"
                          Margin="4"
                          SelectedItemChanged="SheetsTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="SummaryTextBlock"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   FontWeight="Bold" />

        <Grid Grid.Row="2"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="HintTextBlock"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="80"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />

                <Button x:Name="ButtonOK"
                        Content="Разместить"
                        Width="120"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ButtonOK_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
