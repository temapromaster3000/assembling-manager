<Window x:Class="AssemblingManager.Revit.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assembling Manager — Настройки"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Assembling Manager"
                   FontSize="16"
                   FontWeight="Bold" />

        <TextBlock x:Name="VersionText"
                   Margin="0,4,0,14"
                   Foreground="#FF555555" />

        <Button x:Name="CheckButton"
                Content="Проверить обновления"
                MinWidth="180"
                HorizontalAlignment="Left"
                Style="{StaticResource PrimaryButton}"
                Click="CheckButton_Click" />

        <ProgressBar x:Name="DownloadProgress"
                     Height="6"
                     Margin="0,12,0,0"
                     Minimum="0"
                     Maximum="1"
                     Visibility="Collapsed" />

        <TextBlock x:Name="StatusText"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <TextBlock x:Name="NotesHeader"
                   Text="Что нового:"
                   FontWeight="Bold"
                   Margin="0,12,0,4"
                   Visibility="Collapsed" />

        <ScrollViewer x:Name="NotesScroll"
                      MaxHeight="220"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <TextBox x:Name="NotesText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Background="Transparent" />
        </ScrollViewer>

        <Button x:Name="DownloadButton"
                Content="Скачать и установить"
                MinWidth="180"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource PrimaryButton}"
                Visibility="Collapsed"
                Click="DownloadButton_Click" />

        <Button Content="Закрыть"
                Width="90"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Style="{StaticResource PrimaryButton}" />
    </StackPanel>
</Window>
