<Window x:Class="AssemblingManager.Revit.Views.SheetConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Найдены существующие листы"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="440"
        Width="680">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="Transparent"
                                    BorderBrush="#FFD5DFE5"
                                    BorderThickness="0,0,1,1">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Margin="6,5,6,5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Для этих объектов уже есть листы с таким же именем. Отметьте «Заменить», чтобы обновить виды на существующем листе: штамп, номер, аннотации и актуальные виды сохранятся, добавятся только недостающие виды. Если галочка снята — объект не будет затронут."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ListView Grid.Row="1"
                  x:Name="ConflictListView"
                  AlternationCount="2"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F5F7F8" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Заменить"
                                    Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="60">
                                    <CheckBox HorizontalAlignment="Center"
                                              IsChecked="{Binding Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="CheckBox_Click" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Объект"
                                    Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ObjectName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ObjectName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Существующий лист"
                                    Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SheetDisplay}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SheetDisplay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Дубликатов"
                                    Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DuplicatesCount}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2"
              Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TextBlockSelectedCount"
                       VerticalAlignment="Center"
                       Text="Заменяют: 0 из 0" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ButtonSelectAll"
                        Content="Выбрать всё"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="ButtonSelectAll_Click" />

                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="80"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="ButtonCancel_Click" />

                <Button x:Name="ButtonOK"
                        Content="OK"
                        Width="80"
                        IsDefault="True"
                        Click="ButtonOK_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
