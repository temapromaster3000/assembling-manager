<Window x:Class="AssemblingManager.Revit.Views.SortamentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сортаменты труб"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Height="620"
        Width="820"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AssemblingManager;component/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SortamentSecondaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#FFF0F0F0" />
                <Setter Property="Foreground" Value="#FF202020" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFE0E0E0" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FFC8C8C8" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FFE5E5E5" />
                        <Setter Property="Foreground" Value="#FF888888" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SortamentHeader"
                   TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SortamentSizeCell"
                   TargetType="DataGridCell"
                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUsedByPipes}" Value="True">
                        <Setter Property="Background" Value="#FFFFE6E6" />
                        <Setter Property="ToolTip" Value="Данный размер не может быть удален, так как уже используется в проекте" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUsedByPipes}" Value="True" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFFFD0D0" />
                        <Setter Property="Foreground" Value="#FF6A0000" />
                        <Setter Property="ToolTip" Value="Данный размер не может быть удален, так как уже используется в проекте" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUsedByPipes}" Value="False" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFDCEBFF" />
                        <Setter Property="Foreground" Value="#FF1A365D" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SortamentReadOnlyCell"
                   TargetType="DataGridCell"
                   BasedOn="{StaticResource SortamentSizeCell}">
                <Setter Property="BorderBrush" Value="#FFB0B0B0" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SortamentEditableCell"
                   TargetType="DataGridCell"
                   BasedOn="{StaticResource SortamentSizeCell}">
                <Setter Property="BorderBrush" Value="#FFB0B0B0" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style x:Key="SortamentReadOnlyTextBox"
                   TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUsedByPipes}" Value="True">
                        <Setter Property="Background" Value="#FFFFE6E6" />
                        <Setter Property="ToolTip" Value="Данный размер не может быть удален, так как уже используется в проекте" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUsedByPipes}" Value="True" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFFFD0D0" />
                        <Setter Property="Foreground" Value="#FF6A0000" />
                        <Setter Property="ToolTip" Value="Данный размер не может быть удален, так как уже используется в проекте" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsUsedByPipes}" Value="False" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFDCEBFF" />
                        <Setter Property="Foreground" Value="#FF1A365D" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SortamentEditableTextBox"
                   TargetType="TextBox"
                   BasedOn="{StaticResource SortamentReadOnlyTextBox}">
                <Setter Property="IsReadOnly" Value="False" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Выберите существующий каталог размеров труб:"
                   Margin="0,0,0,8" />

        <ComboBox Grid.Row="1"
                  x:Name="SegmentComboBox"
                  Height="28"
                  DisplayMemberPath="DisplayName"
                  SelectionChanged="SegmentComboBox_SelectionChanged" />

        <TextBlock Grid.Row="2"
                   x:Name="SegmentDetailsTextBlock"
                   Margin="0,8,0,10"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <DataGrid Grid.Row="3"
                  x:Name="SizesDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternationCount="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionChanged="SizesDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Номинальный диаметр"
                                        HeaderStyle="{StaticResource SortamentHeader}"
                                        Width="*"
                                        CellStyle="{StaticResource SortamentReadOnlyCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding NominalDiameter, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"
                                     IsReadOnly="True"
                                     Padding="4,2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource SortamentReadOnlyTextBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Наружный диаметр"
                                        HeaderStyle="{StaticResource SortamentHeader}"
                                        Width="*"
                                        CellStyle="{StaticResource SortamentEditableCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding OuterDiameter, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"
                                     Padding="4,2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource SortamentEditableTextBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Толщина стенки"
                                        HeaderStyle="{StaticResource SortamentHeader}"
                                        Width="*"
                                        CellStyle="{StaticResource SortamentEditableCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding WallThickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, StringFormat={}{0:0.###}}"
                                     Padding="4,2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource SortamentEditableTextBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Внутренний диаметр"
                                        HeaderStyle="{StaticResource SortamentHeader}"
                                        Width="*"
                                        CellStyle="{StaticResource SortamentReadOnlyCell}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding InnerDiameter, StringFormat={}{0:0.###}}"
                                     IsReadOnly="True"
                                     Padding="4,2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource SortamentReadOnlyTextBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ButtonAddSize"
                        Content="Добавить размер"
                        Width="125"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource SortamentSecondaryButton}"
                        Click="ButtonAddSize_Click" />
                <Button x:Name="ButtonDeleteSize"
                        Content="Удалить размер"
                        Width="125"
                        Height="32"
                        Style="{StaticResource SortamentSecondaryButton}"
                        Click="ButtonDeleteSize_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ButtonCancel"
                        Content="Отмена"
                        Width="90"
                        Height="32"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Style="{StaticResource SortamentSecondaryButton}"
                        Click="ButtonCancel_Click" />
                <Button x:Name="ButtonApply"
                        Content="Применить"
                        Width="105"
                        Height="32"
                        IsDefault="True"
                        Click="ButtonApply_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
